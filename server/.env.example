NODE_ENV=development
HOST=127.0.0.1
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/it_helpdesk
CLIENT_URL=http://127.0.0.1:5173

JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
MAX_FILES_PER_TICKET=5

# Chỉ dùng cho dữ liệu demo khi chạy npm run seed
SEED_DEFAULT_PASSWORD=Helpdesk@123
